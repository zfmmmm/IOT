<launch>
  <arg name="config_file" default="$(find vins)/../config/realsense_d435i/realsense_stereo_px4_imu_config.yaml"/>
  <arg name="fcu_url" default="/dev/ttyACM0:921600"/>
  <arg name="gcs_url" default=""/>
  <arg name="camera" default="camera"/>

  <arg name="run_camera" default="true"/>
  <arg name="run_mavros" default="true"/>
  <arg name="run_rviz" default="false"/>
  <arg name="run_loop" default="false"/>
  <arg name="initial_reset" default="true"/>

  <group if="$(arg run_camera)">
    <include file="$(find realsense2_camera)/launch/rs_camera.launch">
      <arg name="camera" value="$(arg camera)"/>
      <arg name="enable_fisheye" value="false"/>
      <arg name="enable_depth" value="false"/>
      <arg name="enable_confidence" value="false"/>
      <arg name="enable_color" value="false"/>
      <arg name="enable_gyro" value="false"/>
      <arg name="enable_accel" value="false"/>
      <arg name="enable_infra1" value="true"/>
      <arg name="enable_infra2" value="true"/>
      <arg name="infra_width" value="640"/>
      <arg name="infra_height" value="480"/>
      <arg name="infra_fps" value="30"/>
      <arg name="enable_sync" value="true"/>
      <arg name="align_depth" value="false"/>
      <arg name="initial_reset" value="$(arg initial_reset)"/>
    </include>

    <node pkg="vins" type="disable_realsense_projector.py" name="disable_realsense_projector" output="screen">
      <param name="stereo_module" value="/$(arg camera)/stereo_module"/>
      <param name="timeout" value="20.0"/>
    </node>
  </group>

  <group if="$(arg run_mavros)">
    <include file="$(find mavros)/launch/px4.launch">
      <arg name="fcu_url" value="$(arg fcu_url)"/>
      <arg name="gcs_url" value="$(arg gcs_url)"/>
    </include>
  </group>

  <node pkg="vins" type="vins_node" name="vins_estimator" output="screen" args="$(arg config_file)" required="true"/>
  <node pkg="loop_fusion" type="loop_fusion_node" name="loop_fusion" output="screen" args="$(arg config_file)" if="$(arg run_loop)"/>
  <node pkg="rviz" type="rviz" name="vins_rviz" output="log" args="-d $(find vins)/../config/vins_rviz_config.rviz" if="$(arg run_rviz)"/>
</launch>
